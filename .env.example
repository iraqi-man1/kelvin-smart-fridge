# Copy this file to .env (never share or commit .env).

# Supabase: open your project → Connect → "Session pooler" → copy the URI,
# then put your database password in place of [YOUR-PASSWORD].
# Leave empty to keep using the JSON files in data/.
DATABASE_URL=

# Optional: Supabase's SSL certificate (Project Settings → Database → SSL → Download),
# so the server also checks it is really talking to Supabase.
# DATABASE_CA=C:\path\to\prod-ca-2021.crt

# Optional: how many database connections the server may open (default 5).
# DATABASE_POOL_MAX=5

# Two-step sign-in sends a 6-digit code by email. Easiest: a Gmail "App password"
# (Google Account → Security → 2-Step Verification → App passwords). Or run:
#   powershell -ExecutionPolicy Bypass -File .\scripts\set-gmail.ps1
# GMAIL_USER=name@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Any other provider instead: SMTP_HOST, SMTP_PORT (465/587), SMTP_USER, SMTP_PASS, SMTP_FROM
